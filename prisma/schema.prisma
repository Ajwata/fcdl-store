// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ClientUser {
  id           String   @id
  phone        String   @unique
  name         String
  email        String?
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime
  lastLoginAt  DateTime
}

model ClientSmsCode {
  id        String   @id @default(cuid())
  phone     String   @unique
  verifyId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Booking {
  id                     String   @id
  clientUserId           String?
  clientName             String
  clientPhone            String
  clientPhoneKey         String
  clientEmail            String
  sector                 String
  date                   String
  startTime              String
  endTime                String
  durationHours          Int
  pricePerHour           Int
  totalPrice             Int
  status                 String
  paymentStatus          String
  paymentMethod          String?
  paymentProofUrl        String?
  paymentProofUploadedAt DateTime?
  adminDecisionDueAt     DateTime?
  confirmedAt            DateTime?
  paymentDueAt           DateTime?
  createdAt              DateTime
  notes                  String   @db.Text

  @@index([clientUserId])
  @@index([clientPhoneKey])
  @@index([date, sector])
}

model ClientDiscount {
  clientPhoneKey  String   @id
  clientPhone     String
  discountPercent Int
  updatedAt       DateTime
  updatedById     String?
}

model ClientNotification {
  id           String   @id
  clientUserId String?
  phone        String
  phoneKey     String
  title        String
  message      String   @db.Text
  kind         String
  isRead       Boolean  @default(false)
  readAt       DateTime?
  createdAt    DateTime

  @@index([clientUserId])
  @@index([phoneKey])
  @@index([createdAt])
}

model ClientReview {
  id           String   @id
  bookingId    String
  clientUserId String?
  phone        String
  phoneKey     String
  rating       Int
  text         String   @db.Text
  createdAt    DateTime

  @@index([bookingId])
  @@index([clientUserId])
  @@index([phoneKey])
}

model PaymentSettings {
  id                 String              @id
  adminDecisionHours Int
  updatedAt          DateTime
  paymentWindowRules PaymentWindowRule[]
}

model PaymentWindowRule {
  id                 Int              @id @default(autoincrement())
  settingsId         String
  minDaysBeforeStart Int
  maxDaysBeforeStart Int?
  paymentHours       Int
  sortOrder          Int
  settings           PaymentSettings  @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, sortOrder])
}

model ReferralAssignment {
  clientPhoneKey String   @id
  clientPhone    String
  managerId      String
  managerLogin   String
  managerName    String
  assignedAt     DateTime
  assignedById   String?

  @@index([managerId])
}

model AdminUser {
  id           String   @id
  login        String   @unique
  name         String
  role         String
  passwordHash String
  createdAt    DateTime
}

model PricingSettings {
  id                    String                 @id
  eveningStartHour      Int
  updatedAt             DateTime
  sectors               PricingSector[]
  durationDiscountRules PricingDurationRule[]
}

model PricingSector {
  settingsId    String
  sector        String
  dayPrice      Int
  eveningPrice  Int
  updatedAt     DateTime
  settings      PricingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@id([settingsId, sector])
  @@index([sector])
}

model PricingDurationRule {
  id              Int             @id @default(autoincrement())
  settingsId      String
  minHours        Int
  maxHours        Int?
  discountPercent Int
  sortOrder       Int
  settings        PricingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, sortOrder])
}

model CmsConfig {
  id        String   @id
  content   Json
  updatedAt DateTime
}

model BookingCounter {
  key        String   @id
  nextNumber Int
  updatedAt  DateTime
}

model RateLimitEntry {
  key         String   @id
  count       Int
  windowStart BigInt
  blockedUntil BigInt
  updatedAt   DateTime
}

model ClientAccessControl {
  clientPhoneKey String   @id
  clientPhone    String
  isBlocked      Boolean
  updatedAt      DateTime
  updatedById    String?
}

model ManagerAccessControl {
  managerId    String   @id
  isBlocked    Boolean
  bonusPercent Int
  updatedAt    DateTime
  updatedById  String?
}

model BlockedSlot {
  id        String   @id
  sector    String
  date      String
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime

  @@index([date, sector])
}
